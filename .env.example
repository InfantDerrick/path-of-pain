# PostgreSQL connection (required)
DATABASE_URL=postgresql://jobtracker:jobtracker@localhost:5432/jobtracker

# Canonical public URL of this instance (required in production)
APP_URL=http://localhost:3000

# Session/auth cryptographic secret. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Encrypts email connector credentials. Required when email is enabled.
#   openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-long-random-secret

# true  = anyone can register
# false = registration closed
# auto  = first user can register, then registration closes (default)
REGISTRATION_ENABLED=auto

# local (default) or s3
STORAGE_DRIVER=local
STORAGE_PATH=./data

# disabled | ollama | openai-compatible
AI_PROVIDER=disabled

LOG_LEVEL=info

# Development/build only. Do not set in production.
# SKIP_ENV_VALIDATION=true
# SKIP_DB_MIGRATE=true
