{
  "name": "Path of Pain",
  "short_name": "Path",
  "description": "A private, self-hosted job-search tracker with receipts.",
  "start_url": "/applications",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#efe6d8",
  "theme_color": "#c2410c",
  "categories": ["productivity", "business"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.svg",
      "sizes": "180x180",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Add pain",
      "short_name": "Add",
      "description": "Paste a job URL into the trail.",
      "url": "/applications/new",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    },
    {
      "name": "Open trail",
      "short_name": "Trail",
      "description": "View tracked applications.",
      "url": "/applications",
      "icons": [{ "src": "/icon.svg", "sizes": "any" }]
    }
  ]
}
